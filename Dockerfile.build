# LobsterAI Linux Builder
# Build: docker build -f Dockerfile.build -t lobsterai-linux-builder .
# Run:   docker run --rm -v ./release:/app/release lobsterai-linux-builder
# Output: release/ directory with .AppImage and .deb

FROM node:24-bookworm AS builder

# Install build dependencies for electron-builder Linux targets
RUN apt-get update && apt-get install -y \
    dpkg-dev \
    rpm \
    libarchive-tools \
    fakeroot \
    xvfb \
    git \
    python3 \
    make \
    g++ \
    libgtk-3-dev \
    libnss3-dev \
    libasound2-dev \
    libxss-dev \
    libxtst-dev \
    libdrm-dev \
    libgbm-dev \
    libnotify-dev \
    libsecret-1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone the LobsterAI repo
RUN git clone https://github.com/netease-youdao/LobsterAI.git lobsterai

WORKDIR /app/lobsterai

# Install dependencies
RUN npm install

# Build skills
RUN npm run build:skills

# Build Electron + Vite
RUN npm run build && npm run compile:electron

# Build OpenClaw runtime for Linux x64
RUN npm run openclaw:runtime:linux-x64

# Package Linux targets (AppImage + deb)
RUN npm run dist:linux

# Copy output to /app/release
RUN mkdir -p /app/release && \
    cp -r release/* /app/release/

FROM scratch AS export
COPY --from=builder /app/release /
